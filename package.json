{
  "name": "Webstrates",
  "version": "1.8.1",
  "description": "Webstrates is a research prototype enabling collaborative editing of websites through DOM manipulations realized by Operational Transformation using ShareJS. Webstrates observes changes to the DOM using MutationObservers.",
  "keywords": [
    "Operational Transformation",
    "HCI",
    "Collaborative Editing"
  ],
  "scripts": {
    "start": "npm run build && node webstrates.js",
    "build": "NODE_ENV='production' webpack --mode production",
    "watch": "webpack -w",
    "test": "node tests/lib/run-tests.mjs --bail tests/unit-tests tests/functional-tests",
    "test-all": "node tests/lib/run-tests.mjs tests/unit-tests tests/functional-tests",
    "test-perf": "node tests/lib/run-tests.mjs tests/performance"
  },
  "homepage": "https://www.webstrates.net/",
  "license": "Apache-2.0",
  "author": {
    "name": "Kristian Borup Antonsen",
    "email": "kba@cs.au.dk"
  },
  "contributors": [
    {
      "name": "Clemens N. Klokmose",
      "email": "clemens@cavi.au.dk"
    },
    {
      "name": "Roman Rädle",
      "email": "me@romanraedle.com"
    },
    {
      "name": "Rolf Bagge",
      "email": "rolf@cavi.au.dk"
    }
  ],
  "dependencies": {
    "@babel/core": "8.0.5",
