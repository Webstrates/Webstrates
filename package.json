    "babel-loader": "10.1.1",
    "body-parser": "2.3.0",
    "brotli-dec-wasm": "^2.3.2",
    "bson": "7.3.2",
    "client-sessions": "0.8.0",
    "console-stamp": "3.1.2",
    "csvtojson": "2.0.14",
    "diff-match-patch": "1.0.5",
    "express": "5.2.1",
    "express-ws": "5.0.2",
    "graceful-fs": "4.2.11",
    "http-auth": "4.2.1",
    "human-readable-ids": "1.0.4",
    "json0-ot-diff": "1.1.2",
    "md5-file": "^5.0.0",
    "mime-types": "3.0.2",
    "minimist": "1.2.8",
    "mongodb": "7.6.0",
