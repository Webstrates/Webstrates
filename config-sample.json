{
  "listeningAddress": "0.0.0.0",
  "listeningPort": 7007,
  "db": "mongodb://127.0.0.1:27017/webstrate",
  "uploadsDir": "uploads",
  "niceWebstrateIds": false,
  "maxAge": "1d",
  "maxAssetSize": 100,
  "maxZipEntries": 1000,
  "maxZipUncompressedSize": 256,
  "maxPrototypeUrlRawSize": 100,
  "maxPrototypeUrlDecodedSize": 256,
  "prototypeUrlWhitelist": [
    "^https://(raw\\.githubusercontent|github)\\.com/Webstrates/"
  ],
  "messageRateLimit": {
    "messagesPerInterval": 100,
    "intervalLength": 60000
  },
  "auth": {
    "cookie": {
      "duration": 2592000000,
      "activeDuration": 86400000,
      "secure": true
    },
    "permissionTimeout": 300,
    "defaultPermissions": [
      {
        "username": "anonymous",
        "provider": "",
        "permissions": "rw"
      }
    ],
    "providers": {}
  },
  "basicAuth": {
    "realm": "webstrate",
    "username": "web",
    "password": "strate"
  },
  "tagging": {
    "autotagInterval": 3600,
    "tagPrefix": "Session of "
  },
  "compressedSnapshots": true,
  "compressedSnapshotCacheDir": "snapshot-cache",
  "compressedSnapshotBrotliQuality": 11,
  "compressedSnapshotDebounceMs": 5000,
  "compressedSnapshotMaxStalenessMs": 60000,
  "loggedInPeerConnectionConfig": {
    "iceServers": [
      { "urls": "stun:stun.l.google.com:19302" }
    ]
  },
  "peerConnectionConfig": {
    "iceServers": [
      { "urls": "stun:stun.l.google.com:19302" }
    ]
  }
}
